{
	"folders": [
		{
			"path": ".",
			"name": "命令行工具"
		}
	],
	"settings": {
		// "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild",
		"C_Cpp.default.compileCommands": "builddir/compile_commands.json",
		"C_Cpp.formatting": "clangFormat",
		"C_Cpp.clang_format_style": "file"
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "meson-configure",
				"type": "meson",
				"mode": "reconfigure",
				"presentation": {
					"focus": true,
					"clear": true
				},
				"group": "build"
			},
			{
				"label": "meson-build",
				"type": "meson",
				"mode": "build",
				"problemMatcher": {
					"base": "$gcc",
					"fileLocation": [
						"relative",
						"${workspaceFolder}/builddir/"
					]
				},
				"presentation": {
					"focus": true,
					"clear": true
				},
				"group": {
					"kind": "build",
					"isDefault": true
				}
			},
			{
				"label": "meosn-clean",
				"type": "meson",
				"mode": "clean",
				"isBackground": true,
				"presentation": {
					"clear": true,
					"close": true,
					"reveal": "silent",
					"panel": "shared"
				}
			},
			{
				"label": "meosn-install",
				"type": "meson",
				"mode": "install",
				"isBackground": true,
				"presentation": {
					"clear": true,
					// "close": true,
					"reveal": "silent",
					"panel": "shared"
				},
				"problemMatcher": []
			},
			{
				"label": "run",
				"type": "shell",
				"command": "./${fileBasenameNoExtension}",
				"options": {
					"cwd": "${workspaceFolder}/builddir"
				},
				"presentation": {
					"panel": "shared",
					"clear": true,
					"focus": true
				},
				"group": {
					"kind": "test",
					"isDefault": true
				}
			}
		]
	},
	"launch": {
		"configurations": [
			{
				"name": "current",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder}/builddir/${fileBasenameNoExtension}_debug",
				"args": [],
				"stopAtEntry": true,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"externalConsole": true,
				"MIMode": "gdb",
				"miDebuggerPath": "gdb",
				"setupCommands": [
					{
						"description": "为 gdb 启用整齐打印",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				],
			}
		],
		"compounds": []
	}
}

{
    "folders": [
        {
            "path": ".",
            "name": "命令行工具"
        }
    ],
    "settings": {
        "xmake.compileCommandsDirectory": "build",
        "clangd.arguments": [
            "--compile-commands-dir=build",
            "--function-arg-placeholders=1",
            "--header-insertion=iwyu", //enable: iwyu, disable: never
            "--clang-tidy=1",
            "--all-scopes-completion",
            "--enable-config",
            "--cross-file-rename",
            "--background-index",
            // "--log=verbose",
            "--pretty",
            "--query-driver=C:/Software/mingw64/bin/gcc.exe",
        ],
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "run current",
                "type": "shell",
                "command": "xmake",
                "args": [
                    "run",
                    "${fileBasenameNoExtension}"
                ],
                "presentation": {
                    "panel": "shared",
                    "clear": true,
                    "focus": true
                },
                "group": {
                    "kind": "test",
                    "isDefault": true
                }
            }
        ]
    },
    "launch": {
        "configurations": [
            {
                "name": "current",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/build/${fileBasenameNoExtension}",
                "args": [],
                "stopAtEntry": true,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": true,
                "MIMode": "gdb",
                "miDebuggerPath": "gdb",
                "setupCommands": [
                    {
                        "description": "为 gdb 启用整齐打印",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ],
            }
        ],
        "compounds": []
    }
}

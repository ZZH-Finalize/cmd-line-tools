{
	"folders": [
		{
			"path": ".",
			"name": "命令行工具"
		}
	],
	"settings": {
		"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
		"C_Cpp.default.compileCommands": "build\\compile_commands.json"
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "configure",
				"type": "cmake",
				"command": "configure",
				"presentation": {
					"panel": "shared",
					"clear": true,
					"close": true
				}
			},
			{
				"label": "build",
				"type": "cmake",
				"command": "build",
				"problemMatcher": "$gcc",
				"dependsOn": "configure",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"presentation": {
					"echo": true,
					"panel": "shared",
					"clear": true
				}
			},
			{
				"label": "test",
				"type": "cmake",
				"command": "test",
				"problemMatcher": "$gcc",
				"presentation": {
					"echo": true,
					"panel": "shared",
					"clear": true
				}
			},
			{
				"label": "clean",
				"type": "cmake",
				"command": "clean",
				"isBackground": true,
				"presentation": {
					"panel": "shared",
					"clear": true,
					"close": true,
					"reveal": "silent"
				}
			},
			{
				"label": "run",
				"type": "shell",
				"command": "./${fileBasenameNoExtension}",
				"options": {
					"cwd": "${workspaceFolder}/build"
				},
				"presentation": {
					"panel": "shared",
					"clear": true,
					"focus": true
				},
				"group": {
					"kind": "test",
					"isDefault": true
				}
			}
		]
	},
	"launch": {
		"configurations": [
			{
				"name": "current",
				"type": "cppdbg",
				"request": "launch",
				"program": "${workspaceFolder}/build/${fileBasenameNoExtension}.exe",
				"args": [],
				"stopAtEntry": true,
				"cwd": "${workspaceFolder}",
				"environment": [],
				"externalConsole": true,
				"MIMode": "gdb",
				"miDebuggerPath": "gdb",
				"setupCommands": [
					{
						"description": "为 gdb 启用整齐打印",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				],
			}
		],
		"compounds": []
	}
}

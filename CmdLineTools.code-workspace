{
	"folders": [
		{
			"path": ".",
			"name": "命令行工具"
		}
	],
	"settings": {
		"C_Cpp.default.cStandard": "gnu11",
		"C_Cpp.autocomplete": "Default",
		"C_Cpp.default.cppStandard": "gnu++11",
		"C_Cpp.default.compilerPath": "D:/cygwin64/bin/g++.exe",
		"C_Cpp.default.compilerArgs": [
			"-Wall"
		],
		"C_Cpp.default.includePath": [
			"${workspaceFolder}/**",
			"D:/cygwin64/usr/include**"
		],
		"C_Cpp.default.intelliSenseMode": "linux-gcc-x86",
		"C_Cpp.default.defines": [
			"__OPT_DEBUG"
		],
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/CVS": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
			"**/*.code-workspace": true
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"type": "cppbuild",
				"label": "dbuild",
				"command": "g++",
				"args": [
					"-g3",
					"-o",
					"${fileBasenameNoExtension}.exe",
					"${relativeFile}"
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": true
				},
				"group": {
					"kind": "test",
					"isDefault": true
				},
				"problemMatcher": "$gcc",
				"detail": "构建单个目标(调试)"
			},
			{
				"type": "cppbuild",
				"label": "build",
				"command": "g++",
				"args": [
					"-O2",
					"-o",
					"${fileBasenameNoExtension}.exe",
					"${relativeFile}"
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": true,
					"panel": "shared",
					"showReuseMessage": true,
					"clear": true
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"problemMatcher": "$gcc",
				"detail": "构建单个目标(发布)"
			},
			{
				"type": "shell",
				"label": "clean-one",
				"command": "rm",
				"args": [
					"-f",
					"${relativeFile}",
					"${relativeFile}.stackdump",
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"presentation": {
					"echo": false,
					"reveal": "silent",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": false,
					"clear": true,
					"close": true
				},
				"isBackground": true,
				"detail": "删除单个目标"
			},
			{
				"type": "shell",
				"label": "clean-all",
				"command": "rm",
				"args": [
					"-f",
					"*.exe",
					"*.exe.stackdump",
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"presentation": {
					"echo": false,
					"reveal": "silent",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": false,
					"clear": true,
					"close": true
				},
				"isBackground": true,
				"detail": "删除工作区内全部目标"
			},
			{
				"type": "shell",
				"label": "install",
				"command": "cp",
				"args": [
					"${fileBasenameNoExtension}.exe",
					"/cygdrive/e/path/${fileBasenameNoExtension}.exe",
				],
				"options": {
					"cwd": "${workspaceFolder}"
				},
				"presentation": {
					"echo": false,
					"reveal": "silent",
					"focus": false,
					"panel": "shared",
					"showReuseMessage": false,
					"clear": true,
					"close": true
				},
				"isBackground": true,
				"detail": "安装当前可执行文件到PATH路径"
			},
		]
	},
	"launch": {
		"configurations": [
			{
                "name": "current",
                "type": "cppdbg",
                "request": "launch",
                "program": "${workspaceFolder}/${fileBasenameNoExtension}.exe",
                "args": [],
                "stopAtEntry": true,
                "cwd": "${workspaceFolder}",
                "environment": [],
                "externalConsole": true,
                "MIMode": "gdb",
                "miDebuggerPath": "gdb",
                "setupCommands": [
                    {
                        "description": "为 gdb 启用整齐打印",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ],
            }
		],
		"compounds": []
	}
}
